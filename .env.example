# Coffee Chat environment configuration
# Copy to .env.local for local development. Never commit real secrets.

# Public origin of the web & MCP server (on Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used automatically if omitted)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres database URL (Neon in production).
# Leave empty locally to use .local/pglite, or leave empty on Vercel for read-only UI preview mode (in-memory PGlite + demo community).
DATABASE_URL=

# Optional: set to false on Vercel UI preview to keep the preview database unseeded
# COFFEE_CHAT_SEED_DEMO=true

# Better Auth secret (generate with `openssl rand -base64 32` for production)
BETTER_AUTH_SECRET=

# Social OAuth providers (GitHub + Google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local/CI test auth adapter (strictly ignored when NODE_ENV=production)
COFFEE_CHAT_ENABLE_TEST_AUTH=true
