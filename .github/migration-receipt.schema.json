{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openboa-ai/coffee-chat/blob/main/.github/migration-receipt.schema.json",
  "title": "Coffee Chat migration execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_owner",
    "task",
    "objective",
    "base_commit",
    "empty_base_tree",
    "projection_sha256",
    "equality_receipt_sha256",
    "changed_paths_sha256",
    "package_digest",
    "changed_paths",
    "migrate_evidence",
    "action_counts",
    "verification"
  ],
  "properties": {
    "schema": { "const": "coffee-chat/migration-receipt" },
    "target_owner": { "const": "openboa-ai/coffee-chat" },
    "task": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "base_commit": { "$ref": "#/$defs/sha1" },
    "empty_base_tree": { "$ref": "#/$defs/sha1" },
    "projection_sha256": { "$ref": "#/$defs/sha256" },
    "equality_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "changed_paths_sha256": { "$ref": "#/$defs/sha256" },
    "package_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "surface"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 }
        }
      }
    },
    "migrate_evidence": { "type": "array", "minItems": 2 },
    "action_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrate", "rewrite", "exclude"],
      "properties": {
        "migrate": { "type": "integer" },
        "rewrite": { "type": "integer" },
        "exclude": { "type": "integer" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_deterministic",
        "same_repository_ci",
        "exact_head_review",
        "squash_merge",
        "control_plane"
      ],
      "properties": {
        "local_deterministic": { "const": "passed" },
        "same_repository_ci": { "$ref": "#/$defs/external" },
        "exact_head_review": { "$ref": "#/$defs/external" },
        "squash_merge": { "$ref": "#/$defs/external" },
        "control_plane": { "$ref": "#/$defs/external" }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "external": { "enum": ["pending", "passed", "failed", "unavailable"] }
  }
}
