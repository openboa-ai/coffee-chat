{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    ".github/**/*.mjs",
    "runtime/**/*.mjs",
    "scripts/**/*.mjs",
    "skills/**/*.mjs",
    "tests/**/*.mjs"
  ]
}
