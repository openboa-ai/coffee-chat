# Coffee Chat environment configuration
# Copy to .env.local for local development. Never commit real secrets.

# Public origin of the web & MCP server
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres database URL (Neon in production). Leave empty in local/test mode to use in-process PGlite.
DATABASE_URL=

# Better Auth secret (generate with `openssl rand -base64 32` for production)
BETTER_AUTH_SECRET=

# Social OAuth providers (GitHub + Google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local/CI test auth adapter (strictly ignored when NODE_ENV=production)
COFFEE_CHAT_ENABLE_TEST_AUTH=true
