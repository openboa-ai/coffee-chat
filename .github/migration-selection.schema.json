{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openboa-ai/coffee-chat/blob/main/.github/migration-selection.schema.json",
  "title": "Coffee Chat scoped migration selection projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_owner",
    "task",
    "objective",
    "ledger_sha256",
    "selected_rows",
    "changed_surface_classification"
  ],
  "properties": {
    "schema": { "const": "coffee-chat/migration-selection-projection" },
    "target_owner": { "const": "openboa-ai/coffee-chat" },
    "task": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "ledger_sha256": { "$ref": "#/$defs/sha256" },
    "selected_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "changed_surface_classification": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/classification" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "row": {
      "type": "object",
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "source_blob_oid",
        "content_sha256",
        "action",
        "target_owner",
        "target_path_or_surface",
        "rationale_code",
        "oracle_code",
        "confidence",
        "migration_state"
      ],
      "properties": {
        "source_repository": { "$ref": "#/$defs/nonEmpty" },
        "source_ref": { "$ref": "#/$defs/nonEmpty" },
        "source_commit": { "$ref": "#/$defs/nonEmpty" },
        "source_path": { "$ref": "#/$defs/nonEmpty" },
        "source_blob_oid": { "type": "string" },
        "content_sha256": { "type": "string" },
        "action": { "enum": ["migrate", "rewrite", "exclude"] },
        "target_owner": { "$ref": "#/$defs/nonEmpty" },
        "target_path_or_surface": { "$ref": "#/$defs/nonEmpty" },
        "rationale_code": { "$ref": "#/$defs/nonEmpty" },
        "oracle_code": { "$ref": "#/$defs/nonEmpty" },
        "confidence": { "$ref": "#/$defs/nonEmpty" },
        "migration_state": { "$ref": "#/$defs/nonEmpty" },
        "source_objective_or_failure_mode": { "$ref": "#/$defs/nonEmpty" },
        "replacement_observable_oracle": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "classification": {
      "type": "object",
      "required": ["target_path_or_surface", "classification"],
      "properties": {
        "target_path_or_surface": { "$ref": "#/$defs/nonEmpty" },
        "classification": { "enum": ["ledger-derived", "new-authority"] },
        "selected_rows": { "type": "array" },
        "objective_or_failure_mode": { "$ref": "#/$defs/nonEmpty" },
        "observable_oracle": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
